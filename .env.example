# Placeholders only — copy to .env and fill. Never commit .env.

# ---------- WEB ----------
AUTH_SECRET=
PLATFORM_API_KEY=
AUTH_URL=
NEXT_PUBLIC_APP_URL=
API_URL=http://api:3001
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=AgentArena <onboarding@resend.dev>

# ---------- API (PLATFORM_API_KEY must match web) ----------
ORCHESTRATOR_URL=http://orch:7100
PUBLIC_BASE_URL=
PUBLIC_MCP_BASE_URL=
PLATFORM_EVENT_URL=http://api:3001/v1/internal/sandbox-event
PORT_API=3001
AUTH_DISABLED=false
BEDROCK_API_KEY=
BEDROCK_MODEL_ID=zai.glm-4.7-flash
BEDROCK_REGION=us-east-1
BEDROCK_OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1

# ---------- GATEWAY ----------
PORT_GATEWAY=3002

# ---------- ORCHESTRATOR (docker only) ----------
PORT=7100
USE_DOCKER=require
DOCKER_NETWORK=host
MCP_ADVERTISE_HOST=orch
SANDBOX_IMAGE=agentarena-sandbox-mcp:1.0.0
SANDBOX_ROOT=/var/www/.sandboxes
# Optional remote daemon if Zerops has no docker@ stack / nested dockerd fails:
# DOCKER_HOST=tcp://docker-host:2375
